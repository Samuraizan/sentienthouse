{
  "meta": {
    "lastTouchedVersion": "2026.2.3-1",
    "lastTouchedAt": "2026-02-10T12:00:00.000Z"
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "token"
      }
    }
  },
  "bindings": [
    { "agentId": "blrxzo-jr", "match": { "channel": "telegram", "peer": { "kind": "dm", "id": "DARSHAN_TELEGRAM_ID" } } },
    { "agentId": "wtfxzo-jr", "match": { "channel": "telegram", "peer": { "kind": "dm", "id": "AKHILESH_TELEGRAM_ID" } } },
    { "agentId": "suki",      "match": { "channel": "telegram", "peer": { "kind": "dm", "id": "BOLDRIN_TELEGRAM_ID" } } },
    { "agentId": "main",      "match": { "channel": "telegram" } }
  ],
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5"
      },
      "models": {
        "anthropic/claude-haiku-4-5": {}
      },
      "workspace": "__WORKSPACE_ROOT__",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "1h"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "yana",
        "name": "yana",
        "workspace": "__REPO_ROOT__/workspaces/bd",
        "groupChat": { "mentionPatterns": ["@yana", "Yana", "yana"] }
      },
      {
        "id": "wanda",
        "name": "wanda",
        "workspace": "__REPO_ROOT__/workspaces/sales",
        "groupChat": { "mentionPatterns": ["@wanda", "Wanda", "wanda"] }
      },
      {
        "id": "suki",
        "name": "suki",
        "workspace": "__REPO_ROOT__/workspaces/events"
      },
      {
        "id": "loki",
        "name": "loki",
        "workspace": "__REPO_ROOT__/workspaces/vibe-curator"
      },
      {
        "id": "blrxzo-jr",
        "name": "blrxzo-jr",
        "workspace": "__REPO_ROOT__/workspaces/captain-blrxzo"
      },
      {
        "id": "wtfxzo-jr",
        "name": "wtfxzo-jr",
        "workspace": "__REPO_ROOT__/workspaces/captain-wtfxzo"
      }
    ]
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "botToken": "__TELEGRAM_BOT_TOKEN__",
      "allowFrom": [
        "SAMURAI_TELEGRAM_ID",
        "AKHILESH_TELEGRAM_ID",
        "BOLDRIN_TELEGRAM_ID",
        "DARSHAN_TELEGRAM_ID"
      ],
      "groupPolicy": "allowlist",
      "streamMode": "partial"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "__GATEWAY_TOKEN__"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "google-antigravity-auth": {
        "enabled": true
      }
    }
  }
}
